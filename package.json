{
	"name": "pau",
	"private": true,
	"packageManager": "pnpm@12.3.4",
	"scripts": {
		"build": "pnpm --recursive build",
		"build:website": "pnpm --filter @stormlightlabs/pau-website build",
		"check": "pnpm check:types && pnpm lint",
		"check:types": "pnpm --recursive check",
		"check:generated": "cargo run --quiet -p pau-core --bin generate-protocol -- --check",
		"build:ui": "pnpm --filter @stormlightlabs/pau-ui build",
		"dev:ui": "pnpm --filter @stormlightlabs/pau-ui dev",
		"test:ui": "pnpm --filter @stormlightlabs/pau-ui test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"generate:protocol": "cargo run --quiet -p pau-core --bin generate-protocol",
		"lint": "eslint apps packages --max-warnings=0"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"eslint": "10.11.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"eslint-plugin-unicorn": "76.0.0",
		"globals": "17.12.0",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.1"
	}
}
