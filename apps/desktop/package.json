{
	"name": "@stormlightlabs/pau-desktop",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "node scripts/tauri.mjs build",
		"build:frontend": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"dev": "node scripts/tauri.mjs dev",
		"dev:frontend": "vite dev",
		"release:macos": "node scripts/release-macos.mjs",
		"test": "svelte-kit sync && vitest run --project unit --project browser",
		"test:integration": "cargo build -p pau-server && svelte-kit sync && vitest run --project integration"
	},
	"dependencies": {
		"@stormlightlabs/pau-protocol": "workspace:*",
		"@stormlightlabs/pau-ui": "workspace:*",
		"@tauri-apps/api": "2.9.0",
		"@tauri-apps/plugin-dialog": "2.7.3",
		"@tauri-apps/plugin-notification": "2.4.0",
		"@tauri-apps/plugin-opener": "2.5.5"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "6.2.4",
		"@tauri-apps/cli": "2.11.5",
		"@types/node": "24.13.6",
		"@vitest/browser-playwright": "4.1.11",
		"playwright": "1.63.0",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"vite": "7.3.1",
		"vitest": "4.1.11",
		"vitest-browser-svelte": "3.1.0"
	}
}
