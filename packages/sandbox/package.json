{
	"name": "@stormlightlabs/pau-sandbox",
	"version": "0.0.0",
	"private": true,
	"description": "Local process sandbox and Pi tool host",
	"type": "module",
	"license": "MIT OR Apache-2.0",
	"scripts": {
		"build": "cargo build -p pau-sandbox-denial-preload",
		"check": "tsc -p tsconfig.json",
		"test": "node --test src/credential-broker.test.ts src/credential-proxy.test.ts src/denials.test.ts src/mcp-relay.test.ts src/pi-extension.test.ts src/preload.test.ts src/seatbelt.test.ts src/tool-host-client.test.ts",
		"test:boundary": "cargo build -p pau-sandbox-denial-preload && node src/boundary.ts",
		"test:seatbelt": "node src/seatbelt-smoke.ts",
		"test:pi": "cargo build -p pau-sandbox-denial-preload && node src/pi-smoke.ts"
	},
	"engines": {
		"node": ">=24"
	},
	"dependencies": {
		"@anthropic-ai/sandbox-runtime": "0.0.77",
		"@earendil-works/pi-ai": "1.0.0",
		"@earendil-works/pi-coding-agent": "1.0.0",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@stormlightlabs/pau-protocol": "workspace:*",
		"@types/node": "24.13.6",
		"typescript": "7.0.2"
	}
}
