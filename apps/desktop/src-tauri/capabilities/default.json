{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Native services the main window may request.",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"allow-startup-progress",
		"core:window:allow-close",
		"core:webview:allow-set-webview-zoom",
		"dialog:allow-open",
		"opener:allow-reveal-item-in-dir"
	]
}
