{
	"name": "@stormlightlabs/pau-claude-bridge",
	"version": "0.1.0",
	"description": "Structured Claude Code process bridge for Pi and Pau",
	"type": "module",
	"license": "MIT OR Apache-2.0",
	"keywords": [
		"pi-package"
	],
	"files": [
		"dist",
		"LICENSE-APACHE",
		"LICENSE-MIT",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"bin": {
		"pau-claude-bridge": "./dist/stdio-bridge.js"
	},
	"pi": {
		"extensions": [
			"./dist/pi-extension.js"
		]
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"prepack": "pnpm run build",
		"typecheck:test": "tsc -p tsconfig.test.json",
		"test": "vitest run",
		"test:package": "pnpm run build && node test/packed-artifact.mjs",
		"test:live": "pnpm run build && node test/live-smoke.mjs",
		"check": "pnpm run build && pnpm run typecheck:test && pnpm run test && node test/packed-artifact.mjs"
	},
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.87.1",
		"@types/node": "24.13.6",
		"typebox": "1.3.27",
		"typescript": "7.0.2",
		"vitest": "5.0.1"
	},
	"dependencies": {
		"valibot": "1.5.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	}
}
