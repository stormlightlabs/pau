# Copy to .env for local development. The desktop app, the browser
# development servers, and the macOS release script read it. Variables already
# set in your shell take precedence.

# Shared token for the browser development server and Vite's API proxy.
# Generate one with: openssl rand -hex 32
PAU_API_TOKEN=

# Optional: use another SQLite file instead of the development data directory.
# PAU_DATABASE_PATH=/tmp/pau-dev.sqlite3

# Optional: address of the browser development server.
# PAU_SERVER_ADDR=127.0.0.1:3001

# macOS release signing and notarization, used by `pnpm release:macos`.
# APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
# APPLE_API_KEY=
# APPLE_API_ISSUER=
# APPLE_API_KEY_PATH=
