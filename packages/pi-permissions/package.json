{
	"name": "@stormlightlabs/pau-pi-permissions",
	"version": "0.0.0",
	"private": true,
	"description": "Pi extension that gates tool calls with a per-session Pau permission policy",
	"type": "module",
	"license": "MIT OR Apache-2.0",
	"keywords": [
		"pi-package"
	],
	"files": [
		"dist",
		"src/vendor/pi-permission-system/LICENSE",
		"src/vendor/pi-permission-system/SOURCE.md",
		"LICENSE-APACHE",
		"LICENSE-MIT",
		"README.md"
	],
	"pi": {
		"extensions": [
			"./dist/pi-extension.js"
		]
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"check": "tsc -p tsconfig.json",
		"test": "vitest run",
		"test:pi": "pnpm run build && node test/pi-fixture/run.ts",
		"vendor:verify": "node scripts/vendor.ts --verify"
	},
	"engines": {
		"node": ">=24"
	},
	"dependencies": {
		"tree-sitter-bash": "0.25.1",
		"valibot": "1.5.0",
		"web-tree-sitter": "0.26.9"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "0.87.1",
		"@earendil-works/pi-coding-agent": "0.87.1",
		"@types/node": "24.13.6",
		"esbuild": "0.28.2",
		"typebox": "1.3.27",
		"typescript": "7.0.2",
		"vitest": "5.0.1"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	}
}
